@* Hexágono morado con "C#": inspirado en el logo de C#, dibujado a mano (no es el archivo oficial) *@
<svg class="cs-logo" width="@Size" height="@Size" viewBox="0 0 100 100" role="img" aria-label="Logo de C#">
    <defs>
        <linearGradient id="cs-logo-grad" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#a179dc" />
            <stop offset="1" stop-color="#684d95" />
        </linearGradient>
    </defs>
    <polygon points="50,5 90,27.5 90,72.5 50,95 10,72.5 10,27.5" fill="url(#cs-logo-grad)" stroke="url(#cs-logo-grad)" stroke-width="6" stroke-linejoin="round" />
    <path d="M54.4 37.96 A18 18 0 1 0 54.4 62.04" fill="none" stroke="#ffffff" stroke-width="7.5" stroke-linecap="round" />
    <g stroke="#ffffff" stroke-width="3.4" stroke-linecap="round">
        <line x1="67" y1="36" x2="64.5" y2="64" />
        <line x1="76" y1="36" x2="73.5" y2="64" />
        <line x1="60" y1="46" x2="81.5" y2="44.5" />
        <line x1="59.5" y1="56" x2="81" y2="54.5" />
    </g>
</svg>

@code {
    [Parameter] public int Size { get; set; } = 28;
}
