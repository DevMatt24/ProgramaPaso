            <li><b>Contadores, acumuladores y banderas</b><span>Pronto</span></li>
            <li><b>Métodos</b><span>Pronto</span></li>
            <li><b>Vectores</b><span>Pronto</span></li>
            <li><b>Cadenas de caracteres</b><span>Pronto</span></li>
            <li><b>Depurar código</b><span>Pronto</span></li>
            <li><b>Integrador tipo parcial</b><span>Pronto</span></li>
        </ol>
    </div>

    <footer class="q-foot">
        <a class="cta" href="quiz">Empezar nivel 1</a>
    </footer>
</div>
