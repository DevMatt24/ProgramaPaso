@page "/"
@using ProgramaPaso.Domain
@using ProgramaPaso.Services
@inject ProgressService Progress
@inject AuthService Auth
@inject NavigationManager Nav

<PageTitle>ProgramaPaso · Aprendé C#</PageTitle>

<div class="screen wide">
    <header class="q-head">
        <div class="home-top">
            <div class="avatar" aria-hidden="true">🧑‍💻</div>
            <div class="home-id">
                <b>ProgramaPaso</b>
                <small class="muted">Aprendé C# paso a paso</small>
            </div>
            <ThemeToggle />
            @if (Auth.IsLoggedIn)
            {
                <button class="exit" @onclick="Logout">Salir</button>
            }
        </div>

        <h1 class="prompt big-title">Seguí tu camino</h1>
        <div class="progress">
            <div class="track" role="progressbar" aria-label="Avance total" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@_percent">
                <div class="fill" style="width:@(_percent)%"></div>
            </div>
            <b>@_percent%</b>
        </div>
    </header>

    <div class="q-body home">
        <ol class="levels">
            @foreach (var l in Curriculum.Levels)
            {
                var best = _best.GetValueOrDefault(l.Number, -1);
                var unlocked = l.Available && _unlocked.Contains(l.Number);
                var cls = !unlocked ? "locked" : best >= ProgressService.PassMark ? "open done" : "open";
                if (unlocked && l.Number == _next) { cls += " current"; }
                var stars = Stars(best);

                <li class="level @cls">
                    @if (unlocked)
                    {
                        <a class="card" href="quiz/@l.Number">
                            <div class="icon-box" aria-hidden="true">@l.Icon</div>
                            <div class="level-main">
                                <div class="level-name"><span>@l.Name</span><span class="chev" aria-hidden="true">›</span></div>
                                <p class="level-desc">@l.Title</p>
                                @if (best >= 0)
                                {
                                    <div class="level-meta">
                                        <span class="level-score">@best pts</span>
                                        <span class="stars" aria-label="@stars de 3 estrellas">@(new string('★', stars))<i>@(new string('★', 3 - stars))</i></span>
                                    </div>
                                }
                                <div class="mini-row">
                                    <div class="mini"><span style="width:@(Math.Max(best, 0))%"></span></div>
                                    <small>@(best >= 0 ? $"{best}/100" : "Sin intentos")</small>
                                </div>
                            </div>
                        </a>
                    }
                    else
                    {
                        <div class="card">
                            <div class="icon-box" aria-hidden="true">@l.Icon</div>
                            <div class="level-main">
                                <div class="level-name"><span>@l.Name</span><span aria-hidden="true">🔒</span></div>
                                <p class="level-desc">@l.Title</p>
                                <div class="mini-row">
                                    <div class="mini"><span style="width:0%"></span></div>
                                    <small>@(l.Available ? $"Aprobá {PreviousName(l.Number)} con {ProgressService.PassMark}+" : "Pronto")</small>
                                </div>
                            </div>
                        </div>
                    }
                </li>
            }
        </ol>
    </div>

    <footer class="q-foot">
        <a class="cta" href="quiz/@_next">@_ctaText</a>
        <div class="live">Sacá @ProgressService.PassMark o más para abrir el siguiente nivel</div>
    </footer>
</div>

@code {
    private readonly Dictionary<int, int> _best = new();
    private readonly HashSet<int> _unlocked = new();
    private int _next = 1, _percent;
    private string _ctaText = "Empezar";

    protected override async Task OnInitializedAsync()
    {
        int? firstPending = null;
        int lastUnlocked = 1, passed = 0;

        for (int n = 1; n <= Curriculum.AvailableLevels; n++)
        {
            _best[n] = await Progress.GetBestAsync(n);
            if (_best[n] >= ProgressService.PassMark) passed++;

            if (await Progress.IsUnlockedAsync(n))
            {
                _unlocked.Add(n);
                lastUnlocked = n;
                if (firstPending is null && _best[n] < ProgressService.PassMark) firstPending = n;
            }
        }

        _percent = (int)Math.Round(passed * 100.0 / Curriculum.AvailableLevels);
        _next = firstPending ?? lastUnlocked;

        var name = Curriculum.Levels.First(l => l.Number == _next).Name;
        _ctaText = _best.GetValueOrDefault(_next, -1) >= 0 ? $"Continuar: {name}" : $"Empezar: {name}";
    }

    private static int Stars(int best) => best >= 100 ? 3 : best >= 85 ? 2 : best >= ProgressService.PassMark ? 1 : 0;

    private static string PreviousName(int number)
        => number > 1 ? Curriculum.Levels[number - 2].Name : "";

    private async Task Logout()
    {
        await Auth.SignOutAsync();
        Nav.NavigateTo("login", forceLoad: true);
    }
}
