@page "/quiz"
@page "/quiz/{Level:int}"
@using ProgramaPaso.Domain
@using ProgramaPaso.Services
@inject QuestionBank Bank
@inject QuizEngine Engine
@inject SoundService Sound
@inject ProgressService Progress
@inject NavigationManager Nav

<PageTitle>Nivel @_level · ProgramaPaso</PageTitle>

@if (_quiz is null)
{
    <div class="screen"><p class="muted loading">Preparando tu nivel…</p></div>
}
else if (_result is null)
{
    var q = _quiz[_index];
    var ok = _marks[_index] == true;

    <div class="screen @(_streak >= 3 ? "hot" : "")">
        <header class="q-head">
            <div class="bar">
                <a class="back" href="" aria-label="Volver al inicio">‹</a>
                <div class="steps" role="progressbar" aria-valuemin="0" aria-valuemax="@_quiz.Count" aria-valuenow="@_index">
                    @for (int i = 0; i < _quiz.Count; i++)
                    {
                        var cls = _marks[i] == true ? "step ok" : _marks[i] == false ? "step bad" : i == _index ? "step now" : "step";
                        <span class="@cls"></span>
                    }
                </div>
                <button class="mute" @onclick="ToggleMute" aria-label="@(_muted ? "Activar sonido" : "Silenciar")">@(_muted ? "🔇" : "🔊")</button>
            </div>
            <span class="chip">Nivel @_level · @q.Topic</span>
            @if (q.Type != "choice")
            {
                <span class="chip kind">@(q.Type == "fill" ? "Completar" : "Ordenar")</span>
            }
            <h2 class="prompt" @key="_index">@q.Prompt</h2>
        </header>

        <div class="q-body" @key="_index">
            @switch (q.Type)
            {
                case "fill":
                {
                    var parts = q.Code.Split("___");
                    var size = Math.Max(4, q.Answers.Max(a => a.Length) + 2);
                    var inputClass = "fill-input" + (_answered ? (ok ? " ok" : " bad") : "");

                    if (parts.Length == 2)
                    {
                        <pre class="code">@parts[0]<input class="@inputClass" @bind="_text" @bind:event="oninput" @onkeydown="OnKey" @ref="_input" disabled="@_answered" size="@size" autocomplete="off" autocapitalize="none" spellcheck="false" aria-label="Tu respuesta" />@parts[1]</pre>
                    }
                    else
                    {
                        if (!string.IsNullOrWhiteSpace(q.Code))
                        {
                            <pre class="code">@q.Code</pre>
                        }
                        <input class="@inputClass standalone" @bind="_text" @bind:event="oninput" @onkeydown="OnKey" @ref="_input" disabled="@_answered" autocomplete="off" autocapitalize="none" spellcheck="false" placeholder="Escribí tu respuesta" aria-label="Tu respuesta" />
                    }
                    break;
                }
                case "order":
                {
                    <div class="order-label">Tu código</div>
                    <div class="build @(_answered ? (ok ? "right" : "wrong") : "")">
                        @if (_picked.Count == 0)
                        {
                            <p class="hint">Tocá las líneas de abajo en el orden correcto</p>
                        }
                        @for (int p = 0; p < _picked.Count; p++)
                        {
                            var pos = p;
                            <button class="line placed" disabled="@_answered" @onclick="() => Unpick(pos)">
                                <span class="no">@(p + 1)</span><code>@q.Lines[_picked[p]]</code>
                            </button>
                        }
                    </div>

                    <div class="order-label">Líneas disponibles</div>
                    <div class="pool">
                        @foreach (var idx in _lineOrder)
                        {
                            if (_picked.Contains(idx)) { continue; }
                            var li = idx;
                            <button class="line" disabled="@_answered" @onclick="() => Pick(li)"><code>@q.Lines[li]</code></button>
                        }
                    </div>
                    break;
                }
                default:
                {
                    if (!string.IsNullOrWhiteSpace(q.Code))
                    {
                        <pre class="code">@q.Code</pre>
                    }
                    <div class="options">
                        @for (int i = 0; i < _order.Length; i++)
                        {
                            var original = _order[i];
                            <button class="@OptionClass(original)" disabled="@_answered" @onclick="() => Choose(original)">
                                <span class="letter">@((char)('A' + i))</span>
                                <span>@q.Options[original]</span>
                            </button>
                        }
                    </div>
                    break;
                }
            }

            @if (_answered)
            {
                <div class="feedback @(ok ? "good" : "miss")" @ref="_feedback" tabindex="-1">
                    <strong>@_praise</strong>
                    @if (!ok && q.Type == "fill")
                    {
                        <p>Respuesta correcta: <code class="inline">@q.CorrectText</code></p>
                    }
                    @if (!ok && q.Type == "order")
                    {
                        <pre class="code small">@q.CorrectText</pre>
                    }
                    <p>@q.Explanation</p>
                    @if (!string.IsNullOrWhiteSpace(q.Example))
                    {
                        <pre class="code small">@q.Example</pre>
                    }
                </div>
            }
        </div>

        <footer class="q-foot">
            <button class="cta" disabled="@CtaDisabled(q)" @onclick="OnCta">@CtaText(q)</button>
            <div class="live">
                <span class="dot @(_streak > 0 ? "on" : "")"></span>
                @(_streak > 0 ? $"Racha de {_streak}" : "Sin racha todavía")
            </div>
        </footer>
    </div>
}
else
{
    var correct = _result.Answers.Count(a => a.IsCorrect);
    var passed = _result.Passed(ProgressService.PassMark);
    var hasNext = passed && _level < Curriculum.AvailableLevels;

    <div class="screen @(passed ? "hot" : "")">
        <header class="q-head">
            <div class="bar">
                <a class="back" href="" aria-label="Volver al inicio">‹</a>
                <span class="brand">Resultado · Nivel @_level</span>
            </div>
            <h2 class="prompt">@ResultTitle()</h2>
            <p class="sub">@correct de @_result.Answers.Count correctas · mejor racha: @_bestStreak</p>
        </header>

        <div class="q-body">
            <div class="ring" style="--p:@(_result.Score)">
                <div class="ring-inner"><span class="big">@_result.Score</span><span class="muted">de 100</span></div>
            </div>

            @if (_result.Mistakes.Any())
            {
                <h3 class="review-title">Repasemos lo que se escapó</h3>
                @foreach (var m in _result.Mistakes)
                {
                    <article class="review">
                        <span class="chip dark">@m.Question.Topic</span>
                        <h4>@m.Question.Prompt</h4>

                        @if (m.Question.Type == "order")
                        {
                            <p class="wrong-line">Tu orden:</p>
                            <pre class="code small">@m.Given</pre>
                            <p class="right-line">Orden correcto:</p>
                            <pre class="code small">@m.Question.CorrectText</pre>
                        }
                        else
                        {
                            if (!string.IsNullOrWhiteSpace(m.Question.Code))
                            {
                                <pre class="code small">@m.Question.Code</pre>
                            }
                            <p class="wrong-line">@(m.Question.Type == "fill" ? "Escribiste" : "Elegiste"): @m.Given</p>
                            <p class="right-line">Correcta: @m.Question.CorrectText</p>
                        }

                        <p>@m.Question.Explanation</p>
                        @if (!string.IsNullOrWhiteSpace(m.Question.Example))
                        {
                            <pre class="code small">@m.Question.Example</pre>
                        }
                    </article>
                }
            }
            else
            {
                <p class="muted center">Sin errores. No hay nada que repasar.</p>
            }
        </div>

        <footer class="q-foot">
            @if (hasNext)
            {
                <a class="cta" href="quiz/@(_level + 1)">Ir al nivel @(_level + 1)</a>
                <button class="link-btn" @onclick="Restart">Repetir con otras preguntas</button>
            }
            else
            {
                <button class="cta" @onclick="Restart">Intentar con otras preguntas</button>
                <div class="live">@(passed ? "Completaste todos los niveles disponibles" : $"Necesitás {ProgressService.PassMark} para pasar de nivel")</div>
            }
        </footer>
    </div>
}

@code {
    [Parameter] public int Level { get; set; } = 1;

    private readonly Random _rng = new();
    private List<Question>? _quiz;
    private AnswerResult?[] _answers = Array.Empty<AnswerResult?>();
    private bool?[] _marks = Array.Empty<bool?>();
    private int[] _order = Array.Empty<int>();       // choice: orden mezclado de opciones
    private int[] _lineOrder = Array.Empty<int>();   // order: orden mezclado de líneas
    private readonly List<int> _picked = new();      // order: líneas elegidas por el usuario
    private string _text = "";                       // fill: texto escrito
    private int _level, _index, _pick, _streak, _bestStreak;
    private bool _answered, _scrollToFeedback, _focusInput, _muted;
    private string _praise = "";
    private QuizResult? _result;
    private ElementReference _feedback, _input;

    private static readonly string[] Praises = { "¡Eso es!", "Muy bien.", "Exacto.", "Bien visto." };
    private static readonly string[] StreakPraises = { "¡Tres seguidas!", "Estás en racha.", "Esto ya fluye." };

    protected override async Task OnParametersSetAsync()
    {
        var level = Level is >= 1 and <= Curriculum.AvailableLevels ? Level : 1;
        if (level == _level) return;

        if (!await Progress.IsUnlockedAsync(level))
        {
            Nav.NavigateTo("");   // nivel bloqueado: vuelve al inicio
            return;
        }

        _level = level;
        _quiz = null;
        _muted = await Sound.IsMutedAsync();
        await Restart();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_scrollToFeedback)
        {
            _scrollToFeedback = false;
            try { await _feedback.FocusAsync(); } catch { }
        }
        else if (_focusInput)
        {
            _focusInput = false;
            try { await _input.FocusAsync(); } catch { }
        }
    }

    private async Task Restart()
    {
        var pool = await Bank.GetLevelAsync(_level);
        _quiz = Engine.BuildQuiz(pool, Math.Min(8, pool.Count));
        _answers = new AnswerResult?[_quiz.Count];
        _marks = new bool?[_quiz.Count];
        _index = 0; _streak = 0; _bestStreak = 0;
        _result = null;
        PrepareQuestion();
    }

    private void PrepareQuestion()
    {
        var q = _quiz![_index];
        _answered = false;
        _text = "";
        _picked.Clear();

        // Mezcla opciones/líneas para que no se memorice la posición
        _order = Enumerable.Range(0, q.Options.Count).OrderBy(_ => _rng.Next()).ToArray();

        var lines = Enumerable.Range(0, q.Lines.Count).ToArray();
        for (int tries = 0; tries < 10; tries++)
        {
            lines = lines.OrderBy(_ => _rng.Next()).ToArray();
            if (lines.Length < 2 || !lines.SequenceEqual(Enumerable.Range(0, lines.Length))) break;
        }
        _lineOrder = lines;

        _focusInput = q.Type == "fill";
    }

    // ---------- Respuestas ----------

    private async Task Choose(int original)
    {
        if (_answered) return;
        var q = _quiz![_index];
        _pick = original;
        await Resolve(q, q.Options[original], original == q.Correct);
    }

    private async Task CheckFill()
    {
        var q = _quiz![_index];
        await Resolve(q, _text.Trim(), QuizEngine.CheckText(q, _text));
    }

    private async Task CheckOrder()
    {
        var q = _quiz![_index];
        var given = _picked.Select(i => q.Lines[i]).ToList();
        await Resolve(q, string.Join("\n", given), given.SequenceEqual(q.Lines));
    }

    private async Task Resolve(Question q, string given, bool ok)
    {
        _answered = true;
        _scrollToFeedback = true;
        _marks[_index] = ok;
        _answers[_index] = new AnswerResult(q, given, ok);

        if (ok)
        {
            _streak++;
            _bestStreak = Math.Max(_bestStreak, _streak);
            var list = _streak >= 3 ? StreakPraises : Praises;
            _praise = list[_rng.Next(list.Length)];
            await Sound.PlayAsync(_streak >= 3 ? "streak" : "right");
        }
        else
        {
            _streak = 0;
            _praise = "Casi. Mirá por qué:";
            await Sound.PlayAsync("wrong");
        }
    }

    private async Task Pick(int lineIndex)
    {
        if (_answered) return;
        _picked.Add(lineIndex);
        await Sound.PlayAsync("tap");
    }

    private async Task Unpick(int position)
    {
        if (_answered || position >= _picked.Count) return;
        _picked.RemoveAt(position);
        await Sound.PlayAsync("tap");
    }

    private async Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !_answered && !string.IsNullOrWhiteSpace(_text)) await CheckFill();
    }

    // ---------- Botón principal ----------

    private bool CtaDisabled(Question q) => q.Type switch
    {
        "fill" => !_answered && string.IsNullOrWhiteSpace(_text),
        "order" => !_answered && _picked.Count < q.Lines.Count,
        _ => !_answered
    };

    private string CtaText(Question q)
    {
        if (_answered) return _index + 1 < _quiz!.Count ? "Siguiente" : "Ver mi resultado";
        return q.Type == "choice" ? "Elegí una respuesta" : "Comprobar";
    }

    private async Task OnCta()
    {
        var q = _quiz![_index];
        if (_answered) { await Next(); return; }
        if (q.Type == "fill") await CheckFill();
        else if (q.Type == "order") await CheckOrder();
    }

    private async Task Next()
    {
        if (!_answered) return;

        if (_index + 1 < _quiz!.Count)
        {
            _index++;
            PrepareQuestion();
            return;
        }

        _result = new QuizResult(_answers.Select(a => a!).ToList());
        await Progress.SaveBestAsync(_level, _result.Score);
        await Sound.PlayAsync(_result.Passed(ProgressService.PassMark) ? "win" : "lose");
    }

    private async Task ToggleMute()
    {
        _muted = !_muted;
        await Sound.SetMutedAsync(_muted);
        if (!_muted) await Sound.PlayAsync("tap");
    }

    private string OptionClass(int original)
    {
        if (!_answered) return "opt";
        var q = _quiz![_index];
        if (original == q.Correct) return "opt right";
        if (original == _pick) return "opt wrong";
        return "opt dim";
    }

    private string ResultTitle() => _result!.Score switch
    {
        >= 90 => $"Dominás el nivel {_level}",
        >= ProgressService.PassMark => $"Nivel {_level} superado",
        >= 40 => "Vas por buen camino",
        _ => "Un repaso más y lo sacás"
    };
}
